# SPDX-License-Identifier: MPL-2.0
# Activate development environment
# Install direnv: https://direnv.net/

# Load .tool-versions if asdf is available
if has asdf; then
  use asdf
fi

# Load the Guix shell if the manifest exists. It lives at build/guix.scm, not
# at the root: this test used to look for ./guix.scm, so `use guix` never fired
# and direnv silently provided no toolchain at all.
if has guix && [ -f build/guix.scm ]; then
  use guix -D -f build/guix.scm
fi

# Project environment variables
export PROJECT_NAME="Hermeneia"
export RSR_TIER="infrastructure"
# Add non-secret project env vars above (e.g. DATABASE_URL, service endpoints).
# Real secrets belong in .env (gitignored) — never commit them to .envrc.

# Source .env if it exists (gitignored)
dotenv_if_exists
