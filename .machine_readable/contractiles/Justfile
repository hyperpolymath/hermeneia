# Hermeneia contractile task aliases.
#
# The repository root `Justfile` is the primary task entry point. This small
# file exists only for commands tied directly to the local contractile set; it
# is not a general-purpose project scaffold or a copy of the root Justfile.

set shell := ["bash", "-uc"]
set positional-arguments := true

project := "hermeneia"
OWNER := "hyperpolymath"
REPO := "hermeneia"
version := "0.1.0"
project_kind := "experimental-query-language"
issues_url := "https://github.com/hyperpolymath/hermeneia/issues"

# Show this project's contractile checks.
default:
    @just --list --unsorted

info:
    @echo "Project: {{project}} ({{OWNER}}/{{REPO}})"
    @echo "Version: {{version}}"
    @echo "Kind: {{project_kind}}"
    @echo "Maturity: experimental"
    @echo "Issues: {{issues_url}}"

# Check presence, reciprocal links, registry membership, and manifest hashes.
# This does not parse K9/Nickel or run declared contractile probes.
verify-contractiles:
    @bash scripts/verify-contractiles.sh

# Regenerate manifest hashes after an intentional, reviewed trident edit.
refresh-contractile-hashes:
    @bash scripts/verify-contractiles.sh --update-hashes
    @bash scripts/verify-contractiles.sh

# Verify the Coaptation receipt. Requires Nickel and may fail while the
# committed receipt is stale; never hand-edit that generated file.
verify-coaptation:
    @bash .machine_readable/coaptation/verify.sh

# Run the actual local Rust test suite.
test:
    @cargo test --workspace

# Issue tracker for supervised contractile decisions.
issues:
    @echo "{{issues_url}}"
