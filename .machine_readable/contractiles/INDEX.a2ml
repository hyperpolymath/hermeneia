# SPDX-License-Identifier: MPL-2.0
# INDEX.a2ml — Hermeneia contractile registry
# Author: Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>
#
# This registry describes the six project-specific Hermeneia tridents. It is
# not a registry for a generic template set.

---
id = "hermeneia-contractiles"
version = "2.1.0"
last_updated = "2026-10-03"
base_schema = ".machine_readable/contractiles/_base.ncl"
project = "hyperpolymath/hermeneia"
review_status = "provisional — maintainer ratification required"
runtime_status = "declaration-only; no contractile CLI or generated build/contractile.just is bundled"
structural_verifier = "scripts/verify-contractiles.sh"

[[verbs]]
name = "intend"
semantics = "Hermeneia purpose, implemented scope, committed actions, and wishes"
trident = ["intend/Intentfile.a2ml", "intend/intend.ncl", "intend/intend.k9.ncl"]
manifest = "intend/intend.manifest.a2ml"
status = "active"
tier = "Hunt"
authority = "reporting"
gating = "non-gating"
cardinality = "one per repo"
notes = "Reports progress and aspirations. Current evidence boundary: invoke only, local JSONL store, external tropecheck; Vocarium integration and six other vokes remain pending."

[[verbs]]
name = "must"
semantics = "Hermeneia repository, test, and evidence-boundary invariants"
trident = ["must/Mustfile.a2ml", "must/must.ncl", "must/must.k9.ncl"]
manifest = "must/must.manifest.a2ml"
status = "active"
tier = "Hunt"
authority = "blocking"
gating = "intended blocking gate; only explicitly wired CI checks are executable today"
cardinality = "one per repo"
notes = "The structural trident check, nonempty six-verb Coaptation extraction, placeholder/instantiation checks, Rust tests, and oracle-backed slice are named separately; file presence alone is not a passing probe."

[[verbs]]
name = "trust"
semantics = "Untrusted query/data/IR/oracle boundaries, provenance, and fail-closed behavior"
trident = ["trust/Trustfile.a2ml", "trust/trust.ncl", "trust/trust.k9.ncl"]
manifest = "trust/trust.manifest.a2ml"
status = "active"
tier = "Hunt"
authority = "blocking"
gating = "intended blocking gate; active safe-hacking targets are not authorized"
cardinality = "one per repo"
notes = "Hermeneia is presently a local CLI, not a network service. Grades and warrants are supplied evidence, not semantic truth. An optional VeriSimDB feed declaration exists elsewhere and needs an explicit activation decision; the proposed restricted approval posture also needs owner ratification."

[[verbs]]
name = "adjust"
semantics = "Advisory plain-text accessibility, diagnostic clarity, and implementation-status tolerances"
trident = ["adjust/Adjustfile.a2ml", "adjust/adjust.ncl", "adjust/adjust.k9.ncl"]
manifest = "adjust/adjust.manifest.a2ml"
status = "active"
tier = "Yard"
authority = "advisory"
gating = "advisory; never blocks by itself"
cardinality = "one per repo"
notes = "No graphical UI, WCAG conformance claim, numeric score, or automatic file fix is declared."

[[verbs]]
name = "dust"
semantics = "Safe cleanup and exnovation with history/evidence/rollback preservation"
trident = ["dust/Dustfile.a2ml", "dust/dust.ncl", "dust/dust.k9.ncl"]
manifest = "dust/dust.manifest.a2ml"
status = "active"
tier = "Yard"
authority = "advisory"
gating = "advisory; dry-run and per-item approval for future destructive actions"
cardinality = "one per repo"
notes = "Candidates are only generated outputs. Root build/ is tracked project configuration and is explicitly excluded. No source or voke operation is approved for deletion."

[[verbs]]
name = "bust"
semantics = "Fail-closed stop conditions for unsupported operations, malformed data, oracle faults, and fabricated output"
trident = ["bust/Bustfile.a2ml", "bust/bust.ncl", "bust/bust.k9.ncl"]
manifest = "bust/bust.manifest.a2ml"
status = "active"
tier = "Hunt"
authority = "blocking"
gating = "intended hard stop; probes are synthetic local tests"
cardinality = "one per repo"
notes = "No runtime expiry-bearing credential is asserted. The separate K9-validator failure is not addressed by weakening these contracts."
